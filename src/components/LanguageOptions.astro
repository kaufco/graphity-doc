---
// The entries of the language picker: one per language, with its logo, the selected one marked as the
// current page in the navigation (the style in astro.config.mjs does that from html[data-language]).
import { AVAILABLE_LANGUAGES } from '../lib/languages.mjs';

interface Props {
	/** The name of the radio group; each picker on a page needs its own. */
	name: string;
	/** Hides the heading "Language" from the eye, for a picker that says what it is by its entries. */
	hideLegend?: boolean;
}

const { name, hideLegend = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<fieldset>
	<legend class:list={{ 'sr-only': hideLegend }}>Language</legend>
	{
		AVAILABLE_LANGUAGES.map((language, i) => (
			<label class={`language-option language-option-${language.key}`}>
				<input type="radio" name={name} value={language.key} checked={i === 0} />
				<img src={`${base}logos/${language.key}.svg`} alt="" width="24" height="20" />
				<span>{language.label}</span>
			</label>
		))
	}
</fieldset>

<style>
	fieldset {
		border: 0;
		margin: 0;
		padding: 0;
	}
	legend:not(.sr-only) {
		padding: 0;
		margin-bottom: 0.5rem;
		color: var(--sl-color-white);
		font-size: var(--sl-text-h5);
		font-weight: 600;
		line-height: var(--sl-line-height-headings);
	}
	.language-option {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.25rem 0.5rem;
		border-inline-start: 3px solid transparent;
		border-radius: 0 6px 6px 0;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		cursor: pointer;
	}
	.language-option:hover {
		background-color: var(--sl-color-gray-6);
	}
	.language-option:has(input:focus-visible) {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: -2px;
	}
	.language-option input {
		position: absolute;
		opacity: 0;
		pointer-events: none;
	}
	.language-option img {
		flex: none;
		width: 1.5rem;
		height: 1.25rem;
		object-fit: contain;
	}
</style>
