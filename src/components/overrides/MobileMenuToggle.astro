---
// The button of the menu on a narrow screen: a plain symbol, as the search next to it, the open book
// for the table of contents, which turns into a close symbol while the menu is open.
import { Icon } from '@astrojs/starlight/components';
---

<button popovertarget="starlight__sidebar" class="sl-menu-button sl-flex md:sl-hidden print:hidden">
	<Icon name="open-book" class="open-menu" size="1.25rem" />
	<Icon name="close" class="close-menu" size="1.25rem" />
	<span class="sr-only">{Astro.locals.t('menuButton.accessibleLabel')}</span>
</button>

<style>
	button {
		position: fixed;
		top: calc((var(--sl-nav-height) - var(--sl-menu-button-size)) / 2);
		inset-inline-end: var(--sl-nav-pad-x);
		z-index: var(--sl-z-index-navbar);
		align-items: center;
		justify-content: center;
		width: var(--sl-menu-button-size);
		height: var(--sl-menu-button-size);
		padding: 0;
		border: 0;
		background: none;
		color: var(--sl-color-gray-1);
		cursor: pointer;
	}
	button:has(~ :popover-open) .open-menu {
		display: none;
	}
	button:not(:has(~ :popover-open)) .close-menu {
		display: none;
	}
</style>

<style is:global>
	body:has(#starlight__sidebar:popover-open) {
		overflow: hidden;
	}
	@media (min-width: 50rem) {
		body:has(#starlight__sidebar:popover-open) {
			overflow: auto;
		}
	}
</style>
