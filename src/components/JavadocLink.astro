---
// A link to the start page of the Javadoc, its overview (index.html), wherever the Javadoc lives
// (src/lib/java-api.mjs, javadocBaseUrl).
import { javadocBaseUrl } from '../lib/java-api.mjs';

const href = `${javadocBaseUrl().replace(/\/?$/, '/')}index.html`;
---

<a href={href}><slot /></a>
