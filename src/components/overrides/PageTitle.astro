---
// Starlight's page title, with the number of a chapter or problem page in front of it. The numbers
// follow from the order in src/lib/structure.mjs.
import { pageNumbers } from '../../lib/structure.mjs';

const { entry, id } = Astro.locals.starlightRoute;
const number = pageNumbers().get(id);
---

<h1 id="_top">{number && <><span class="page-number">{number}</span>{' '}</>}{entry.data.title}</h1>

<style>
	h1 {
		margin-top: 1rem;
		font-size: var(--sl-text-h1);
		line-height: var(--sl-line-height-headings);
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.page-number {
		margin-inline-end: 0.25em;
	}
</style>
